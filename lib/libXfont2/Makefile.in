installcheck: installcheck-recursive
install-strip:
	if test -z '$(STRIP)'; then \
	  $(MAKE) $(AM_MAKEFLAGS) INSTALL_PROGRAM="$(INSTALL_STRIP_PROGRAM)" \
	    install_sh_PROGRAM="$(INSTALL_STRIP_PROGRAM)" INSTALL_STRIP_FLAG=-s \
	      install; \
	else \
	  $(MAKE) $(AM_MAKEFLAGS) INSTALL_PROGRAM="$(INSTALL_STRIP_PROGRAM)" \
	    install_sh_PROGRAM="$(INSTALL_STRIP_PROGRAM)" INSTALL_STRIP_FLAG=-s \
	    "INSTALL_PROGRAM_ENV=STRIPPROG='$(STRIP)'" install; \
	fi
mostlyclean-generic:
	-test -z "$(LIBOBJS)" || rm -f $(LIBOBJS)
	-test -z "$(LTLIBOBJS)" || rm -f $(LTLIBOBJS)
	-test -z "$(TEST_LOGS)" || rm -f $(TEST_LOGS)
	-test -z "$(TEST_LOGS:.log=.trs)" || rm -f $(TEST_LOGS:.log=.trs)
	-test -z "$(TEST_SUITE_LOG)" || rm -f $(TEST_SUITE_LOG)

clean-generic:
	-test -z "$(CLEANFILES)" || rm -f $(CLEANFILES)

distclean-generic:
	-test -z "$(CONFIG_CLEAN_FILES)" || rm -f $(CONFIG_CLEAN_FILES)
	-test . = "$(srcdir)" || test -z "$(CONFIG_CLEAN_VPATH_FILES)" || rm -f $(CONFIG_CLEAN_VPATH_FILES)
	-rm -f src/FreeType/$(DEPDIR)/$(am__dirstamp)
	-rm -f src/FreeType/$(am__dirstamp)
	-rm -f src/bitmap/$(DEPDIR)/$(am__dirstamp)
	-rm -f src/bitmap/$(am__dirstamp)
	-rm -f src/builtins/$(DEPDIR)/$(am__dirstamp)
	-rm -f src/builtins/$(am__dirstamp)
	-rm -f src/fc/$(DEPDIR)/$(am__dirstamp)
	-rm -f src/fc/$(am__dirstamp)
	-rm -f src/fontfile/$(DEPDIR)/$(am__dirstamp)
	-rm -f src/fontfile/$(am__dirstamp)
	-rm -f src/stubs/$(DEPDIR)/$(am__dirstamp)
	-rm -f src/stubs/$(am__dirstamp)
	-rm -f src/util/$(DEPDIR)/$(am__dirstamp)
	-rm -f src/util/$(am__dirstamp)
	-rm -f test/$(DEPDIR)/$(am__dirstamp)
	-rm -f test/$(am__dirstamp)
	-rm -f test/utils/$(DEPDIR)/$(am__dirstamp)
	-rm -f test/utils/$(am__dirstamp)

maintainer-clean-generic:
	@echo "This command is intended for maintainers to use"
	@echo "it deletes files that may require special tools to rebuild."
	-test -z "$(MAINTAINERCLEANFILES)" || rm -f $(MAINTAINERCLEANFILES)
@HAVE_PYTHON_FALSE@clean-local:
